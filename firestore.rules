rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of a tenant
    function isTenantAdmin(tenantId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
    }

    // Tenants collection: publicly readable, only admins can update their own
    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isTenantAdmin(tenantId);
    }
    
    // Tournaments, Teams, and Matches
    // Public can read, but only the specific tenant's admin can write
    
    match /tournaments/{documentId} {
      allow read: if true;
      allow write: if isTenantAdmin(request.resource.data.tenantId) || isTenantAdmin(resource.data.tenantId);
    }
    
    match /teams/{documentId} {
      allow read: if true;
      allow write: if isTenantAdmin(request.resource.data.tenantId) || isTenantAdmin(resource.data.tenantId);
    }
    
    match /matches/{documentId} {
      allow read: if true;
      allow write: if isTenantAdmin(request.resource.data.tenantId) || isTenantAdmin(resource.data.tenantId);
    }
  }
}
